// Firma por defecto: ad hoc («Sign to Run Locally»). Sirve para compilar sin cuenta.
// Para firmar con tu equipo personal (permisos de macOS estables entre builds), crea
// Config/Signing.local.xcconfig (no se versiona) con:
//   CODE_SIGN_STYLE = Automatic
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <tu Team ID>
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
#include? "Signing.local.xcconfig"
